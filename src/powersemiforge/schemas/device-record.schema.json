{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powersemiforge.dev/schemas/device-record.schema.json",
  "title": "PowerSemiForge Device Record",
  "type": "object",
  "required": ["schema_version", "device_id", "vendor", "part_number", "parameters"],
  "properties": {
    "schema_version": {"type": "string"},
    "device_id": {"type": "string", "minLength": 1},
    "vendor": {"type": "string", "minLength": 1},
    "part_number": {"type": "string", "minLength": 1},
    "technology": {"type": ["string", "null"]},
    "package": {"type": ["string", "null"]},
    "ratings": {"type": "object"},
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "provenance", "confidence"],
        "properties": {
          "name": {"type": "string"},
          "value": {"type": ["number", "string"]},
          "unit": {"type": ["string", "null"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "conditions": {"type": "object"},
          "provenance": {"type": "object"}
        }
      }
    },
    "curve_assets": {"type": "array"},
    "model_assets": {"type": "array"},
    "metadata": {"type": "object"}
  }
}

